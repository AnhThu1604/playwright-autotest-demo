{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": "./tests",
    "paths": {
      "@framework/*": [
        "framework/*"
      ],
      "@test-data/*": [
        "test-data/*"
      ],
      "@ui/*": [
        "ui/*"
      ],
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts"
  ]
}